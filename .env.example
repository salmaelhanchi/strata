# Copy to .env and adjust. Every setting is optional; defaults match deploy/docker-compose.yml.

# ADR-003: an honest User-Agent that names the project's repository
STRATA_USER_AGENT="strata/0.1 (+https://github.com/YOUR_GITHUB_USER/strata)"

# Postgres for the ops schema (jobs, budget ledger, policies, fetch attempts)
STRATA_OPS_DSN=postgresql://strata:strata@localhost:5432/strata_ops

# DuckLake catalog (libpq key=value form) and where its Parquet files go
STRATA_LAKE_CATALOG="dbname=ducklake_catalog host=localhost port=5432 user=strata password=strata"
STRATA_LAKE_DATA_PATH=data/lake

# Use a plain DuckDB file instead of DuckLake (no DuckDB extensions needed; one process at a time)
# STRATA_LAKE_LOCAL_FILE=data/lake.duckdb

STRATA_RAW_ROOT=data/raw
STRATA_CACHE_DIR=data/cache

# Seconds to wait before retries 1..n (jitter adds up to 25%); Retry-After wins when longer
# STRATA_BACKOFF_S=[2, 10, 30, 60]

# Tests: point them at the compose Postgres instead of starting a throwaway one
# STRATA_TEST_PG_DSN=postgresql://strata:strata@localhost:5432/strata_ops
