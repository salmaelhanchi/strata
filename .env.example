# Copy to a file named `.env` (with the dot) in this folder; Strata reads nothing else.
# Every setting has a default that matches deploy/docker-compose.yml, so lines stay commented
# unless you change them.

# ---- Raw parts and lake files on RustFS instead of local folders (ADR-005) -----------------
# Uncomment the whole block. The S3 lake gets its own catalog database, because a lake's data
# path is fixed when its catalog is created; `strata migrate` (or any run) creates that
# database and both buckets.
# STRATA_RAW_STORE=s3
# STRATA_S3_ENDPOINT=http://localhost:9000
# STRATA_S3_ACCESS_KEY=strata-local
# STRATA_S3_SECRET_KEY=strata-local-secret
# STRATA_S3_RAW_BUCKET=strata-raw
# STRATA_LAKE_DATA_PATH=s3://strata-lake/
# STRATA_LAKE_CATALOG="dbname=ducklake_s3 host=localhost port=5432 user=strata password=strata"

# ---- Defaults, for reference ------------------------------------------------------------
# Postgres for the ops schema (jobs, budget ledger, policies, fetch attempts, robots verdicts)
# STRATA_OPS_DSN=postgresql://strata:strata@localhost:5432/strata_ops
# DuckLake catalog (libpq key=value) and where its Parquet files go
# STRATA_LAKE_CATALOG="dbname=ducklake_catalog host=localhost port=5432 user=strata password=strata"
# STRATA_LAKE_DATA_PATH=data/lake
# Keep flushes of up to this many rows in the catalog until CHECKPOINT (0 = a file per flush)
# STRATA_LAKE_INLINING_ROWS=0
# A plain DuckDB file instead of DuckLake (no extensions needed; one process at a time)
# STRATA_LAKE_LOCAL_FILE=data/lake.duckdb
# Raw parts are staged here first (the write-ahead log), then sealed into the raw store
# STRATA_RAW_ROOT=data/raw
# STRATA_RAW_STORE=file
# STRATA_CACHE_DIR=data/cache

# ADR-003: an honest User-Agent that names the project's repository
# STRATA_USER_AGENT="strata/0.2 (+https://github.com/salmaelhanchi/strata)"
# DuckDB threads for URL-index queries, 1 or 2; each can hold a range request open (ADR-004)
# STRATA_INDEX_THREADS=1
# Seconds to wait before retries 1..n (jitter adds up to 25%); Retry-After wins when longer
# STRATA_BACKOFF_S=[2, 10, 30, 60]
# A running job writes a heartbeat every STRATA_HEARTBEAT_S seconds; a job whose heartbeat is
# older than STRATA_STALE_AFTER_S is treated as dead, and running its command again continues it
# STRATA_HEARTBEAT_S=5
# STRATA_STALE_AFTER_S=60
# Logs on stderr: debug, info, warning or error; console or json lines
# STRATA_LOG_LEVEL=warning
# STRATA_LOG_FORMAT=console
# Where `strata console` keeps the pages it pulls
# STRATA_CONSOLE_DB=data/console.duckdb
# Crash-resume rehearsals only: the process exits at this crash point (see crash.py)
# STRATA_CRASH_AT=after_manifest:400

# Tests: point them at the compose Postgres instead of starting a throwaway one
# STRATA_TEST_PG_DSN=postgresql://strata:strata@localhost:5432/strata_ops
